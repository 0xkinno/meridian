{
  "name": "meridian-keeperhub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "setup-check": "node --experimental-strip-types --env-file=.env.local scripts/setup-check.ts",
    "verify:phase-2-3": "tsx --env-file=.env.local scripts/verify-phase-2-3.ts",
    "execute:phase-4": "tsx --env-file=.env.local scripts/execute-phase4.ts",
    "execute:workflow-phase-4": "tsx --env-file=.env.local scripts/execute-workflow-phase4.ts",
    "verify:phase-5": "tsx --env-file=.env.local scripts/verify-phase5.ts",
    "verify:phase-6": "tsx --env-file=.env.local scripts/verify-phase6.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "^14.2.35",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^4.1.10"
  }
}
